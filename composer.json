{
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-imagick": "*",
    "doctrine/annotations": "^2.0",
    "doctrine/doctrine-bundle": "^2.11",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^2.17",
    "firebase/php-jwt": "^6.10",
    "funcai/funcai-php": "^0.5.4",
    "nelmio/cors-bundle": "^2.3",
    "phpdocumentor/reflection-docblock": "^5.3",
    "phpstan/phpdoc-parser": "^1.16",
    "symfony/apache-pack": "^1.0",
    "symfony/asset": "7.2.*",
    "symfony/console": "7.2.*",
    "symfony/doctrine-messenger": "7.2.*",
    "symfony/messenger": "7.2.*",
    "symfony/clock": "7.2.*",
    "symfony/cache": "7.2.*",
    "symfony/var-exporter": "7.2.*",
    "symfony/event-dispatcher": "7.2.*",
    "symfony/options-resolver": "7.2.*",
    "symfony/config": "7.2.*",
    "symfony/filesystem": "7.2.*",
    "symfony/dependency-injection": "7.2.*",
    "symfony/error-handler": "7.2.*",
    "symfony/var-dumper": "7.2.*",
    "symfony/http-foundation": "7.2.*",
    "symfony/dotenv": "7.2.*",
    "symfony/expression-language": "7.2.*",
    "symfony/firebase-notifier": "7.2.*",
    "symfony/flex": "^2",
    "symfony/form": "7.2.*",
    "symfony/framework-bundle": "7.2.*",
    "symfony/http-kernel": "7.2.*",
    "symfony/finder": "7.2.*",
    "symfony/routing": "7.2.*",
    "symfony/password-hasher": "7.2.*",
    "symfony/security-core": "7.2.*",
    "symfony/security-csrf": "7.2.*",
    "symfony/security-http": "7.2.*",
    "symfony/twig-bridge": "7.2.*",
    "symfony/dom-crawler": "7.2.*",
    "symfony/http-client": "7.2.*",
    "symfony/intl": "7.2.*",
    "symfony/mailer": "7.2.*",
    "symfony/mime": "7.2.*",
    "symfony/notifier": "7.2.*",
    "symfony/process": "7.2.*",
    "symfony/property-access": "7.2.*",
    "symfony/property-info": "7.2.*",
    "symfony/runtime": "7.2.*",
    "symfony/security-bundle": "7.2.*",
    "symfony/serializer": "7.2.*",
    "symfony/string": "7.2.*",
    "symfony/translation": "7.2.*",
    "symfony/twig-bundle": "7.2.*",
    "symfony/validator": "7.2.*",
    "symfony/web-link": "7.2.*",
    "symfony/webpack-encore-bundle": "^2.1",
    "symfony/yaml": "7.2.*",
    "symfony/doctrine-bridge": "7.2.*",
    "symfony/monolog-bundle": "^3.10",
    "symfony/monolog-bridge": "7.2.*",
    "twig/cssinliner-extra": "^3.8",
    "twig/extra-bundle": "^3.8",
    "twig/inky-extra": "^3.8",
    "twig/twig": "^3.8"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^3.4",
    "friendsofphp/php-cs-fixer": "*",
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^9.5",
    "symfony/browser-kit": "7.2.*",
    "symfony/css-selector": "7.2.*",
    "symfony/debug-bundle": "7.2.*",
    "symfony/maker-bundle": "^1.52",
    "symfony/phpunit-bridge": "^7.2",
    "symfony/stopwatch": "7.2.*",
    "symfony/web-profiler-bundle": "7.2.*"
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.2.*"
    }
  }
}
