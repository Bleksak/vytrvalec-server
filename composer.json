{
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-imagick": "*",
    "amphp/http-server-router": "^2.0",
    "amphp/log": "^2.0",
    "amphp/websocket-server": "^4.0",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^3.0",
    "doctrine/orm": "^3.5",
    "firebase/php-jwt": "^6.11",
    "kreait/firebase-bundle": "^5.7",
    "kreait/firebase-php": "*",
    "nelmio/api-doc-bundle": "*",
    "nelmio/cors-bundle": "^2.6",
    "phpdocumentor/reflection-docblock": "^5.6",
    "picocss/pico": "dev-main",
    "symfony/asset": "8.0.*",
    "symfony/cache": "8.0.*",
    "symfony/clock": "8.0.*",
    "symfony/config": "8.0.*",
    "symfony/console": "8.0.*",
    "symfony/dependency-injection": "8.0.*",
    "symfony/doctrine-bridge": "8.0.*",
    "symfony/doctrine-messenger": "8.0.*",
    "symfony/dom-crawler": "8.0.*",
    "symfony/dotenv": "8.0.*",
    "symfony/error-handler": "8.0.*",
    "symfony/event-dispatcher": "8.0.*",
    "symfony/expression-language": "8.0.*",
    "symfony/filesystem": "8.0.*",
    "symfony/finder": "8.0.*",
    "symfony/flex": "^2",
    "symfony/form": "8.0.*",
    "symfony/framework-bundle": "8.0.*",
    "symfony/http-client": "8.0.*",
    "symfony/http-foundation": "8.0.*",
    "symfony/http-kernel": "8.0.*",
    "symfony/intl": "8.0.*",
    "symfony/mailer": "8.0.*",
    "symfony/messenger": "8.0.*",
    "symfony/mime": "8.0.*",
    "symfony/monolog-bridge": "8.0.*",
    "symfony/monolog-bundle": "^4.0",
    "symfony/notifier": "8.0.*",
    "symfony/options-resolver": "8.0.*",
    "symfony/password-hasher": "8.0.*",
    "symfony/process": "8.0.*",
    "symfony/property-access": "8.0.*",
    "symfony/property-info": "8.0.*",
    "symfony/routing": "8.0.*",
    "symfony/runtime": "8.0.*",
    "symfony/scheduler": "8.0.*",
    "symfony/security-bundle": "8.0.*",
    "symfony/security-core": "8.0.*",
    "symfony/security-csrf": "8.0.*",
    "symfony/security-http": "8.0.*",
    "symfony/serializer": "8.0.*",
    "symfony/stimulus-bundle": "^2.31",
    "symfony/string": "8.0.*",
    "symfony/translation": "8.0.*",
    "symfony/twig-bridge": "8.0.*",
    "symfony/twig-bundle": "8.0.*",
    "symfony/uid": "8.0.*",
    "symfony/ux-icons": "^2.31",
    "symfony/ux-live-component": "^2.31",
    "symfony/ux-turbo": "^2.31",
    "symfony/ux-twig-component": "^2.31",
    "symfony/validator": "8.0.*",
    "symfony/var-dumper": "8.0.*",
    "symfony/var-exporter": "8.0.*",
    "symfony/web-link": "8.0.*",
    "symfony/yaml": "8.0.*",
    "symfonycasts/sass-bundle": "^0.8.3",
    "thiagoalessio/tesseract_ocr": "^2.13",
    "twig/cssinliner-extra": "^3.21",
    "twig/extra-bundle": "^3.21",
    "twig/inky-extra": "^3.21",
    "twig/intl-extra": "^3.22",
    "twig/twig": "^3.21"
  },
  "require-dev": {
    "carthage-software/mago": "^1.0.0",
    "phpunit/phpunit": "^12.3",
    "symfony/browser-kit": "8.0.*",
    "symfony/css-selector": "8.0.*",
    "symfony/debug-bundle": "8.0.*",
    "symfony/maker-bundle": "^1.64",
    "symfony/phpunit-bridge": "^8.0",
    "symfony/stopwatch": "8.0.*",
    "symfony/web-profiler-bundle": "8.0.*",
    "vincentlanglet/twig-cs-fixer": "^3.10"
  },
  "config": {
    "allow-plugins": {
      "carthage-software/mago": true,
      "composer/package-versions-deprecated": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "importmap:install": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.0.*"
    }
  },
  "repositories": {
    "pico": {
      "type": "vcs",
      "url": "https://github.com/Bleksak/pico"
    }
  }
}
