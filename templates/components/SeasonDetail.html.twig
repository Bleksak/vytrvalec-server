<article>
    <twig:Heading>
        <div class="grid">
            <h1>{{ title|trans }}</h1>

            {% if heading %}
                {{ heading|raw }}
            {% endif %}
        </div>
        <div class="grid">
            <span class="season-detail-date">
                <twig:ux:icon name="lucide:calendar-range" />{{
                    'season_detail.date_range'|trans({
                        start: season.start|format_date(dateformat: 'long'),
                        end: season.end|format_date(dateformat: 'long')
                    })
                }}
            </span>
            <div class="grid" data-skip-morph>
                {% for row in ranking.rows|slice(0, 3) %}
                    <div
                        style="background-color: {{
                        faculties[row.faculty].color
                        }};"
                        class="season-detail-winner-badge"
                    >
                        {% if loop.first %}
                            <twig:ux:icon
                                name="lucide:trophy"
                                width="24"
                                height="24"
                            />
                        {% else %}
                            <twig:ux:icon
                                name="lucide:medal"
                                width="24"
                                height="24"
                            />
                        {% endif %}
                        {{
                            'season_detail.finish_place'|trans({
                                place: loop.index,
                                name: faculties[row.faculty].shortcut
                            })
                        }}
                    </div>
                {% endfor %}
            </div>
        </div>
    </twig:Heading>
    <div class="grid season-detail-charity-grid">
        <div class="season-detail-charity-image-container" data-skip-morph>
            {% if season.charity.image %}
                <img
                    src="{{
                    season.charity.image.path is defined
                        ? absolute_url(season.charity.image.path)
                        : ''
                    }}"
                    alt="{{ season.charity.translations[app.locale].name }}"
                    class="season-detail-charity-image"
                />
            {% else %}
                <div class="season-detail-charity-placeholder-content">
                    <twig:ux:icon name="lucide:image" width="48" height="48" />
                    <span>{{ 'season_detail.charity.no_image'|trans }}</span>
                </div>
            {% endif %}
        </div>
        <section class="season-detail-charity">
            <article data-skip-morph>
                <h2>{{ season.charity.translations[app.locale].name }}</h2>
                {% if
                    season.charity.translations[app.locale].description is not empty %}
                    <p>
                        {{
                            season.charity.translations[app.locale].description
                        }}
                    </p>
                {% endif %}
                {% if season.charity.website %}
                    <div>
                        <a
                            href="{{ season.charity.website }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            role="button"
                        >
                            <twig:ux:icon
                                name="lucide:external-link"
                                width="24"
                                height="24"
                            />
                            {{ 'season_detail.charity.visit'|trans }}
                        </a>
                    </div>
                {% endif %}
            </article>
            <article class="season-detail-money-collected">
                <div class="grid season-detail-money-icon-container">
                    <twig:ux:icon
                        name="lucide:coins"
                        width="1rem"
                        height="1rem"
                    />
                </div>
                <span>
                    {{
                        'season_detail.charity.raised'|trans({
                            money: (ranking.totalDistance / 1000)|number_format
                        })
                    }}
                </span>
            </article>
        </section>
    </div>
</article>
