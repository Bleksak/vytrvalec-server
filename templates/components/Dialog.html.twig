<dialog id="{{ id }}" data-controller="dialog" closedby="any" {{ attributes }}>
    <article>
        <header class="dialog-header">
            <h5>
                {% block header %}

                {% endblock header %}
            </h5>

            <button type="button" command="close" commandfor="{{ id }}">
                <twig:ux:icon name="lucide:x" />
            </button>
        </header>
        <section>
            {% block content %}

            {% endblock content %}
        </section>
    </article>
</dialog>
