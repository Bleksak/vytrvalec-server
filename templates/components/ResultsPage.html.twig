<div {{ attributes }}>
    {% set heading %}
        <div class="flex-gap">
            <select data-model="currentWeekIndex">
                <option :value="0">
                    {{ 'results.week_picker.whole_season'|trans }}
                </option>
                <option value="1">
                    {{ 'results.week_picker.first_week'|trans }}
                </option>
                <option value="2">
                    {{ 'results.week_picker.second_week'|trans }}
                </option>
                <option value="3">
                    {{ 'results.week_picker.third_week'|trans }}
                </option>
                <option value="4">
                    {{ 'results.week_picker.fourth_week'|trans }}
                </option>
            </select>
            <select data-model="currentSeasonIndex">
                {% for season in seasonList %}
                    <option value="{{ loop.index0 }}">
                        {{ season.start|format_date(pattern: 'MMMM y') }}
                    </option>
                {% endfor %}
            </select>
        </div>
    {% endset %}

    <section>
        <twig:SeasonDetail
            :heading="heading"
            :faculties="faculties"
            :season="currentSeason"
            :seasonResult="currentSeasonResult"
            :key="currentSeasonIndex"
        />
    </section>
    <article data-skip-morph>
        <section>
            {% if (seasonResultRanking|length) == 0 %}
                <h2>{{ 'results.no_results'|trans }}</h2>
            {% else %}
                <div class="tabs">
                    <input
                        data-model="currentActivityIndex"
                        type="radio"
                        id="tab-activity-total"
                        name="activity-tabs"
                        value="0"
                        checked
                    />
                    <label for="tab-activity-total">
                        {{ 'results.total'|trans }}
                    </label>

                    {% for activity in activities %}
                        <input
                            data-model="currentActivityIndex"
                            type="radio"
                            id="tab-activity-{{ activity.id }}"
                            name="activity-tabs"
                            value="{{ activity.id }}"
                        />
                        <label for="tab-activity-{{ activity.id }}">
                            {{ activity.translations[app.locale].name }}
                        </label>
                    {% endfor %}
                </div>
                <h2>
                    {% if currentActivityIndex == 0 %}
                        {{ 'results.total'|trans }}
                    {% else %}
                        {{
                            activities[currentActivityIndex].translations[app.locale].name
                        }}
                    {% endif %}
                </h2>
                <table class="striped">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'results.faculty'|trans }}</th>
                            <th class="text-right" scope="col">
                                {{ 'results.distance'|trans }}
                            </th>
                            <th class="text-right" scope="col">
                                {{ 'results.points'|trans }}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for result in seasonResultRanking.rows %}
                            <tr>
                                <td>
                                    {{ faculties[result.faculty].shortcut }}
                                </td>
                                <td class="text-right">
                                    {{
                                        (result.distance / 1000)|number_format(
                                            1
                                        )
                                    }} km
                                </td>
                                <td class="text-right">{{ result.points }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>{{ 'results.total'|trans }}</td>
                            <td class="text-right">
                                {{
                                    (seasonResultRanking.totalDistance
                                        / 1000)|number_format(1)
                                }} km
                            </td>
                            <td class="text-right">
                                {{ seasonResultRanking.totalPoints }}
                            </td>
                        </tr>
                    </tfoot>
                </table>
                <hr />
                <section>
                    {{
                        render_chart(
                            chart,
                            {
                                'data-controller': 'results-chart'
                            }
                        )
                    }}
                </section>

                {% if
                    not currentSeason.end < ('2022-01-01'|date)
                        and seasonResultRanking.extras is not empty %}
                    <section>
                        <h2>{{ 'results.extras.title'|trans }}</h2>
                        <div class="table-container">
                            <table class="striped">
                                <thead>
                                    <tr>
                                        <th>
                                            {{ 'results.extras.name'|trans }}
                                        </th>
                                        <th>
                                            {{ 'results.extras.faculty'|trans }}
                                        </th>
                                        <th>
                                            {{
                                                'results.extras.category'|trans
                                            }}
                                        </th>
                                        <th>
                                            {{
                                                'results.extras.activity'|trans
                                            }}
                                        </th>
                                        <th class="text-right">
                                            {{ 'results.extras.value'|trans }}
                                        </th>
                                        <th class="text-right">
                                            {{ 'results.extras.points'|trans }}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for extra in seasonResultRanking.extras %}
                                        <tr>
                                            <td>
                                                {{
                                                    users[extra.user].firstName
                                                }}
                                                {{ users[extra.user].lastName }}
                                            </td>
                                            <td>
                                                {{
                                                    faculties[extra.faculty].shortcut
                                                }}
                                            </td>
                                            <td>
                                                {{
                                                    ('results.extras.'
                                                        ~ extra.name)|trans
                                                }}
                                            </td>
                                            <td>
                                                {{
                                                    activities[extra.activity].translations[app.locale].name
                                                }}
                                            </td>
                                            <td class="text-right">
                                                {% if
                                                    extra.name
                                                        == 'weekly_elevation' %}
                                                    {{
                                                        extra.value|number_format
                                                    }} m
                                                {% else %}
                                                    {{
                                                        (extra.value
                                                            / 1000)|number_format(
                                                            1
                                                        )
                                                    }} km
                                                {% endif %}
                                            </td>
                                            <td class="text-right">
                                                {{ extra.points }}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </section>
                {% endif %}

                {% if currentWeekIndex == 0 %}
                    {% if currentSeasonResult.outliers is not empty %}
                        {% if currentActivityIndex == 0 %}
                            {% for outlier_activity in currentSeasonResult.outliers %}
                                <section>
                                    <h2>
                                        {{ 'results.outliers.title'|trans }} ({{
                                            activities[outlier_activity.activityId].translations[app.locale].name
                                        }})
                                    </h2>
                                    <table class="striped">
                                        <thead>
                                            <tr>
                                                <th>
                                                    {{
                                                        'results.outliers.name'|trans
                                                    }}
                                                </th>
                                                <th class="text-right">
                                                    {{
                                                        'results.faculty'|trans
                                                    }}
                                                </th>
                                                <th class="text-right">
                                                    {{
                                                        'results.distance'|trans
                                                    }}
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for row in outlier_activity.results %}
                                                <tr>
                                                    <td>
                                                        {{
                                                            users[row.user].firstName
                                                        }}
                                                        {{
                                                            users[row.user].lastName
                                                        }}
                                                    </td>
                                                    <td class="text-right">
                                                        {{
                                                            faculties[row.facultyId].shortcut
                                                        }}
                                                    </td>
                                                    <td class="text-right">
                                                        {{
                                                            (row.value
                                                                / 1000)|number_format(
                                                                1
                                                            )
                                                        }} km
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </section>
                            {% endfor %}
                        {% elseif
                            currentSeasonResult.outliers[currentActivityIndex] is not empty %}
                            <section>
                                <h2>
                                    {{ 'results.outliers.title'|trans }} ({{
                                        activities[currentActivityIndex].translations[app.locale].name
                                    }})
                                </h2>
                                <table class="striped">
                                    <thead>
                                        <tr>
                                            <th>
                                                {{
                                                    'results.outliers.name'|trans
                                                }}
                                            </th>
                                            <th class="text-right">
                                                {{ 'results.faculty'|trans }}
                                            </th>
                                            <th class="text-right">
                                                {{ 'results.distance'|trans }}
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for row in currentSeasonResult.outliers[currentActivityIndex].results %}
                                            <tr>
                                                <td>
                                                    {{
                                                        users[row.user].firstName
                                                    }}
                                                    {{
                                                        users[row.user].lastName
                                                    }}
                                                </td>
                                                <td class="text-right">
                                                    {{
                                                        faculties[row.facultyId].shortcut
                                                    }}
                                                </td>
                                                <td class="text-right">
                                                    {{
                                                        (row.value
                                                            / 1000)|number_format(
                                                            1
                                                        )
                                                    }} km
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </section>
                        {% endif %}
                    {% endif %}
                    <section>
                        <h2>{{ 'results.user_count_by_faculty'|trans }}</h2>
                        <table class="striped">
                            <thead>
                                <tr>
                                    <th>{{ 'results.faculty'|trans }}</th>
                                    <th class="text-right">
                                        {{ 'results.user_count'|trans }}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in userFacultyStatistics.users %}
                                    <tr>
                                        <td>
                                            {{
                                                faculties[row.faculty].shortcut
                                            }}
                                        </td>
                                        <td class="text-right">
                                            {{ row.count }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>{{ 'results.total'|trans }}</td>
                                    <td class="text-right">
                                        {{ userFacultyStatistics.total }}
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </section>
                {% endif %}
            {% endif %}
        </section>
    </article>
</div>
