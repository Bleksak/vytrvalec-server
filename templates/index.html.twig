{% extends 'base.html.twig' %}

{% block body %}
    <section>
        <div class="grid">
            <article>
                <twig:Heading>
                    <h1>Měsíční Vytrvalec</h1>
                </twig:Heading>
                <p>
                    {{ 'home.intro'|trans }}
                </p>
                <a role="button" class="secondary" href="{{ path('rules') }}">
                    {{ 'navbar.rules'|trans|upper }}
                </a>
                <a role="button" href="{{ path('results') }}">
                    {{ 'navbar.results'|trans|upper }}
                </a>
            </article>
            <article>
                <twig:Heading>
                    <h1>{{ 'home.about.title'|trans }}</h1>
                </twig:Heading>

                <p>
                    {{ 'home.about.content'|trans }}
                </p>
            </article>
        </div>
    </section>

    {% if (statistics.activities|length) > 0 %}
        <section>
            <article>
                <twig:Heading>
                    <h1>{{ 'home.statistics.title'|trans }}</h1>
                </twig:Heading>
                <div class="grid">
                    <div class="statistics-card">
                        <twig:ux:icon
                            name="lucide:person-standing"
                            class="statistics-card-image filter-blue"
                        />
                        <div class="statistics-card-value">
                            <span class="statistics-card-value-numeric">
                                {{ statistics.users }}
                            </span>
                            <span class="statistics-card-heading">
                                {{ 'home.statistics.users'|trans }}
                            </span>
                        </div>
                    </div>
                    {% for activity_statistic in statistics.activities %}
                        <div class="statistics-card">
                            <img
                                class="statistics-card-image filter-blue"
                                src="{{ activity_statistic.activity.icon }}"
                                alt=""
                            />
                            <div class="statistics-card-value">
                                <span class="statistics-card-value-numeric">
                                    {{
                                        (activity_statistic.distance
                                            / 1000)|number_format
                                    }}&nbsp;km
                                </span>
                                <span class="statistics-card-heading">
                                    {{ activity_statistic.activity.name.cs }}
                                </span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </article>
        </section>
    {% endif %}

    {% if last_season %}
        <section>
            <twig:SeasonDetail
                :faculties="faculties"
                :season="last_season"
                :seasonResult="last_season_result"
            />
        </section>
    {% endif %}

    <section>
        <article>
            <Heading>
                <h1>Sponzoři Akce</h1>
            </Heading>
            <div class="sponsors">
                <a href="https://www.decathlon.cz/?utm_source=vytrvalec">
                    <img
                        src="{{ asset('/images/decathlon-logo.png') }}"
                        title="Decathlon"
                        alt="Decathlon"
                    />
                </a>
            </div>
        </article>
    </section>
{% endblock body %}
