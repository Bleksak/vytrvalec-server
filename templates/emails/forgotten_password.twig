{% extends "emails/template.twig" %}
{% block content %}
    <container>
    <row>
    <columns>
    <p>Vážený uživateli,</p>
    <p>
        Obdrželi jsme žádost o změnu hesla vašeho účtu. Pro dokončení procesu změny hesla prosím klikněte na následující odkaz:
    </p>
    <p>
        <a href="{{ password_reset_link }}">{{ password_reset_link }}</a>
