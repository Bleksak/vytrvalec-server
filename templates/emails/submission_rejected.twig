{% extends "emails/template.twig" %}
{% block content %}
    <container>
    <row>
    <columns>
    <p>Vážený uživateli,</p>
    <p>
        Vaše aktivita na portálu Měsíčního Vytrvalce byla zamítnuta
        {% if message is not empty %}
            z následujícího důvodu:
        </p>
        <p>
            {{ message }}
        {% endif %}
    </p>
    <p>
        Děkujeme za účast,
        <br />
        Ústav tělesné výchovy a sportu
    </p>
    </columns>
    </row>
    </container>
{% endblock %}
