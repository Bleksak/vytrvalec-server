{% extends 'base.html.twig' %}

{% block body %}
    <main>
        <article>
            <h2 class="no-transform">{{ 'rules.title'|trans }}</h2>
            <section>
                <p>
                    {{ 'rules.intro.content1'|trans }}
                </p>
                <p>
                    {{ 'rules.intro.content2'|trans }}
                </p>
            </section>

            <section>
                <h4>{{ 'rules.disciplines.title'|trans }}</h4>
                <ul>
                    <li>{{ 'rules.activities.run_walk'|trans }}</li>
                    <li>{{ 'rules.activities.bicycle'|trans }}</li>
                </ul>
            </section>

            <section>
                <h4>{{ 'rules.progress.title'|trans }}</h4>
                <ul>
                    <li>{{ 'rules.progress.content1'|trans }}</li>
                    <li>{{ 'rules.progress.content2'|trans }}</li>
                </ul>
            </section>

            <section>
                <h4>{{ 'rules.target_activities.title'|trans }}</h4>
                <ul>
                    <li>{{ 'rules.target_activities.body'|trans }}</li>
                    <li>{{ 'rules.target_activities.supplement'|trans }}</li>
                </ul>
            </section>

            <section>
                <h4>{{ 'rules.extra_points.title'|trans }}</h4>
                <p>
                    {{ 'rules.extra_points.intro'|trans }}
                </p>
                <ul>
                    <li>
                        {{ 'rules.extra_points.third_week.title'|trans }}<ul>
                            <li>
                                1 <strong>
                                    {{ 'rules.extra_points.extra_point'|trans }}
                                </strong>
                                {{
                                    'rules.extra_points.third_week.extra_one'|trans
                                }}
                            </li>
                            <li>
                                2 <strong>
                                    {{
                                        'rules.extra_points.extra_points'|trans
                                    }}
                                </strong>
                                {{
                                    'rules.extra_points.third_week.extra_two'|trans
                                }}
                            </li>
                        </ul>
                    </li>
                    <li>
                        {{ 'rules.extra_points.fourth_week.title'|trans }}<ul>
                            <li>
                                1 <strong>
                                    {{ 'rules.extra_points.extra_point'|trans }}
                                </strong>
                                {{
                                    'rules.extra_points.fourth_week.extra_one'|trans
                                }}
                            </li>
                        </ul>
                    </li>
                </ul>
            </section>
        </article>
    </main>
{% endblock body %}
