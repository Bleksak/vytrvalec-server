{% extends 'base.html.twig' %}

{% block title %}{{ 'title'|trans }}{% endblock %}

{% block body %}

<div class="main">
  <div class="col title">
    <h1>{{ 'title'|trans|upper }}</h1>
    <h2>{{ 'join_us'|trans }}</h2>
  </div>
</div>

<div class="about">
  <h2><strong>{{ 'about_challenge'|trans }}</strong></h2>
  <p>{{ 'challenge_description'|trans|raw }}</p>

  <div class="row py-4 px-5 text-center">
    <div class="col-md-4">
      <h3><b>10 </b></h3>
      {# <h3><b>{{ users_count }}</b></h3> #}
      {{ 'participants'|trans }}
    </div>
    <div class="col-md-4">
      <h3><b>20 km</b></h3>
      {# <h3><b>{{ bike_km|floatformat:0 }}</b> km</h3> #}
      {{ 'bike_and_scooter'|trans }}
    </div>
    <div class="col-md-4">
      <h3><b>200 km</b></h3>
      {# <h3><b>{{ run_km|floatformat:0 }}</b> km</h3> #}
      {{ 'run_and_walk'|trans }}
    </div>
  </div>
</div>

<div class="row tags light-blue-bg">
  <div class="col-md-6">
    <h4 class="text-center">{{ 'winners'|trans }}</h4>
    <div class="slideshow blue-border white-bg home-tag">
      <div id="controls1" class="carousel slide" data-bs-interval="false">
        <div class="carousel-inner">
          {% for season in seasons %}
            <div class="carousel-item {% if loop.first %}active{% endif %}">
              {# <h5><strong>{{ season }}</strong></h5> #}
              <p>
                  {# {% for winner in season.sum_results|slice:3 %} #}
                    {# {% if forloop.counter is 1 %} #}
                      <i class="fa-solid fa-crown gold"></i>
                    {# {% elif forloop.counter is 2 %} #}
                      <i class="fa-solid fa-crown silver"></i>
                    {# {%else%} #}
                      <i class="fa-solid fa-crown bronze"></i>
                    {# {%endif%} #}
                  {# <strong>{{ forloop.counter|ordinal }}</strong> {% trans winner.0 %} #}
              </p>

              {# {% endfor %} #}
            </div>
            {% endfor %}

            <div class="carousel-item">
              {# <h5><strong>{% trans 'october'%} 2021</strong></h5> #}
              {# <p><i class="fa-solid fa-crown gold"></i><strong> {{ 1|ordinal }}</strong> {% trans 'FZS' %}</p> #}
              {# <p><i class="fa-solid fa-crown silver"></i><strong> {{ 2|ordinal }}</strong> {% trans 'FST' %}</p> #}
              {# <p><i class="fa-solid fa-crown bronze"></i><strong> {{ 3|ordinal }}</strong> {% trans 'FEK' %}</p> #}
            </div>

            <div class="carousel-item">
              {# <h5><strong>{% trans 'october'%} 2020</strong></h5> #}
              {# <p><i class="fa-solid fa-crown gold"></i><strong> {{ 1|ordinal }}</strong> {% trans 'FZS' %}</p> #}
              {# <p><i class="fa-solid fa-crown silver"></i><strong> {{ 2|ordinal }}</strong> {% trans 'FST' %}</p> #}
              {# <p><i class="fa-solid fa-crown bronze"></i><strong> {{ 3|ordinal }}</strong> {% trans 'FPE' %}</p> #}
            </div>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#controls1" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#controls1" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <h4 class="text-center">{{ 'charity'|trans }}</h4>
      <div class="slideshow blue-border white-bg tag2">
        <div id="controls2" class="carousel slide" data-bs-interval="false">
          <div class="carousel-inner">
            {# {% if seasons %} {% for season in seasons %} {% if forloop.counter is 1 %} #}
            <div class="carousel-item active">
              {# {% else %} #}
              <div class="carousel-item">
                {# {% endif %} #}
                {# <h5>{{ season }}: <strong>{{ season.charity_name }}</strong></h5> #}
                {# <p>{{ season.charity_description }}</p> #}
              </div>
              {# {% endfor %} {% else %} {% trans 'NoData'%} {% endif %} #}

              <div class="carousel-item">
                {# <h5>{% trans 'october' %} 2021: <strong>DAVID a GOLIÁŠ - Kubík</strong></h5> #}
                <p>
                  Kubík – kombinované postižení- 11let. Kubík se v bříšku vyvíjel jako úplně zdravé miminko, ale při porodu se
                  dost přidusil, což se projevilo na jeho mozečku. Diagnóza DMO.
                </p>
              </div>

              <div class="carousel-item">
                {# <h5>{% trans 'october' %} 2020: <strong>Anička a Jiřík</strong></h5> #}
                {# {% comment %} <p>Nemůžu najít odkaz</p> {% endcomment %} #}
                <!-- TODO najít/sehnat něco -->
              </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#controls2" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#controls2" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% endblock %}

